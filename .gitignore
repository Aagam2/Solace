# Local agent, credential, and machine configuration
/.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example

# Dependencies and tool caches
node_modules/
/.task/
/.cache/
.eslintcache
*.tsbuildinfo
__pycache__/
*.py[codz]

# Compiled application and frontend output
/bin/
/build/bin/
/frontend/dist/*
!/frontend/dist/.gitkeep
/build/linux/solace.desktop
/build/windows/icon.ico
/build/darwin/icons.icns
/build/darwin/Assets.car
/wails_windows_*.syso

# Mobile build products (keep the checked-in project scaffolds)
/build/android/.gradle/
/build/android/**/build/
/build/ios/DerivedData/
/build/ios/**/xcuserdata/

# Test and coverage output
/coverage/
/frontend/coverage/
/test-results/
/playwright-report/
*.cover
*.lcov

# Local Solace runtime data
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/logs/
/media/
/thumbnails/
/backups/

# Editors and operating-system clutter
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

